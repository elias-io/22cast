{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["./worker-configuration.d.ts", "node"],
    "skipLibCheck": true
  },
  "include": ["worker/**/*.ts", "worker-configuration.d.ts", "release.json"]
}
