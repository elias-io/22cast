---
import release from '../../release.json';
import Legal from '../components/Legal.astro';
import '../styles/site.css';

const androidVersion = release.minSdk <= 24 ? '7.0' : String(release.minSdk);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#13170f" />
    <meta name="description" content="A little closer. Mirror your iPhone, iPad or Mac to your Android TV with 22Cast. Free, open source, and without ads or analytics." />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://22cast.elias.dev/" />
    <title>22Cast — A little closer.</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#downloads">Skip to downloads</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="#top" aria-label="22Cast home">
          <svg class="brand-mark" viewBox="0 0 64 52" aria-hidden="true" fill="none">
            <path d="M5 12V7a3 3 0 0 1 3-3h49a3 3 0 0 1 3 3v37a3 3 0 0 1-3 3H38" />
            <path d="M4 24c13 0 24 11 24 24M4 35c7 0 13 6 13 13" />
            <circle cx="4" cy="48" r="2" fill="currentColor" stroke="none" />
          </svg>
          <span>22Cast</span>
        </a>
        <span class="header-note">A little closer.</span>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <svg class="hero-mark" viewBox="0 0 64 52" aria-hidden="true" fill="none">
            <path d="M5 12V7a3 3 0 0 1 3-3h49a3 3 0 0 1 3 3v37a3 3 0 0 1-3 3H38" />
            <path d="M4 24c13 0 24 11 24 24M4 35c7 0 13 6 13 13" />
            <circle cx="4" cy="48" r="2" fill="currentColor" stroke="none" />
          </svg>
          <p class="eyebrow">Made for your living room</p>
          <h1 id="hero-title">A small screen.<br /><span>A bigger moment.</span></h1>
          <p class="hero-description">Mirror your iPhone, iPad or Mac to your Android TV.</p>

          <div class="downloads" id="downloads" aria-label="Get 22Cast">
            {release.storeUrl ? (
              <a class="download-button store-button" href={release.storeUrl}>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m6 3 14 9L6 21V3Z" /></svg>
                <span><strong>Download from app store</strong><small>Google Play</small></span>
              </a>
            ) : (
              <button class="download-button store-button" type="button" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m6 3 14 9L6 21V3Z" /></svg>
                <span><strong>Download from app store</strong><small>Coming soon</small></span>
              </button>
            )}
            <a class="download-button apk-button" href={release.apkUrl} data-tv-default download>
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M12 3v12m-5-5 5 5 5-5M4 16v4h16v-4" /></svg>
              <span><strong>Download APK</strong><small>Install directly on Android</small></span>
            </a>
          </div>
          <p class="release-info">Version {release.versionName}<span aria-hidden="true">·</span>Android {androidVersion}+<span aria-hidden="true">·</span>Free &amp; open source</p>
        </section>

        <footer class="site-footer">
          <p>No accounts. No ads. No analytics.</p>
          <nav aria-label="Information">
            <a href="#privacy">Privacy</a>
            <a href="#terms">Terms</a>
            <a href="#imprint">Legal notice</a>
            <a href="https://github.com/elias-io/22cast">Source code</a>
          </nav>
        </footer>

        <div class="legal-content">
          <Legal />
        </div>
      </main>
    </div>
    <script>
      import '../scripts/tv-navigation';
    </script>
  </body>
</html>
